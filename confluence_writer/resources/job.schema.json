{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VBlackJack/confluence-rag-builder/contracts/job.schema.json",
  "title": "Confluence conversion job",
  "type": "object",
  "x-maximum-job-bytes": 8388608,
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "file_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!\\.\\.?$)[^\\\\/]+$"
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachment_id",
        "file_name",
        "media_type",
        "path",
        "is_drawio_source"
      ],
      "properties": {
        "attachment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "file_name": {
          "$ref": "#/$defs/file_name"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "path": {
          "$ref": "#/$defs/relative_path",
          "x-maximum-file-bytes": 268435456
        },
        "is_drawio_source": {
          "type": "boolean"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "title",
        "space_key",
        "version",
        "updated_at",
        "author",
        "canonical_url",
        "xhtml_path",
        "attachments"
      ],
      "properties": {
        "page_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "space_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "canonical_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https?://"
        },
        "xhtml_path": {
          "$ref": "#/$defs/relative_path",
          "x-maximum-file-bytes": 67108864
        },
        "attachments": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/attachment"
          }
        }
      }
    }
  }
}
